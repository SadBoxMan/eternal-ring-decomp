# ER-003: assembly macros for splat's output, written for the 1999 EE assembler (GNU as 2.9-ee-991111).
# splat's default macro.inc targets modern gas (quoted labels, "\()" token pasting); ee-as rejects those.

.ifndef _MACRO_INC_GUARD
_MACRO_INC_GUARD = 1

# .extern size hints for every symbol the split reaches through $gp (generated by tools/gen_gp_externs.py)
.include "gp_externs.inc"

# A function symbol.
.macro glabel label, visibility=global
    .\visibility \label
    .type \label, @function
\label:
    .ent \label
.endm

# The end of a function symbol.
.macro endlabel label
    .size \label, . - \label
    .end \label
.endm

# An alternative entry to a function.
.macro alabel label, visibility=global
    .\visibility \label
    .type \label, @function
\label:
.endm
# (ee-as 2.9 has no .aent; the label alone gives the same bytes)

# A label referenced by an error handler table.
.macro ehlabel label, visibility=global
    .\visibility \label
\label:
.endm

# A label referenced by a jump table.
.macro jlabel label, visibility=global
    .\visibility \label
\label:
.endm

# A data symbol.
.macro dlabel label, visibility=global
    .\visibility \label
    .type \label, @object
\label:
.endm

# End of a data symbol.
.macro enddlabel label
    .size \label, . - \label
.endm

# splat marks unmatched symbols with "<label>.NON_MATCHING"; ee-as has no "\()" pasting, so this is a
# no-op here. Progress is counted from the sources (INCLUDE_ASM lines), not from these symbols.
.macro nonmatching label, size=1
.endm

.endif
